+
+    /// The service type Settings browses for pairable hosts.
+    private static let serviceType = "_remotepairing-pairable-host._tcp."
+
+    /// no-wifi: registers the service for this iPhone alone.
+    ///
+    /// With Wi-Fi off there's no local network for `NetService` to advertise
+    /// on. dns_sd gives a service registered on
+    /// `kDNSServiceInterfaceIndexLocalOnly` to every client on this iPhone
+    /// browsing on any interface, which is how Settings fills its
+    /// “Pair with …” list. The SRV target is `localhost`, where the listener,
+    /// bound to `::`, answers over IPv4 and IPv6.
+    private func advertiseLocalOnly(serviceID: String, port: Int32, txt: [String: Data]) {
+        let record = NetService.data(fromTXTRecord: txt)
+        // kDNSServiceInterfaceIndexLocalOnly is ((uint32_t)-1), a macro Swift
+        // doesn't import.
+        let localOnly = UInt32.max
+        var ref: DNSServiceRef?
+        let err = record.withUnsafeBytes { bytes in
+            DNSServiceRegister(&ref, 0, localOnly, serviceID, Self.serviceType, nil, "localhost.",
+                               UInt16(truncatingIfNeeded: port).bigEndian,
+                               UInt16(truncatingIfNeeded: record.count), bytes.baseAddress,
+                               localOnlyRegistered, nil)
+        }
+        guard Int(err) == kDNSServiceErr_NoError, let registered = ref else {
+            engine.log("RPPairing: ⚠️ couldn't register \(serviceID) for this iPhone (dns_sd error \(err)).")
+            return
+        }
+        let started = DNSServiceSetDispatchQueue(registered, DispatchQueue.main)
+        guard Int(started) == kDNSServiceErr_NoError else {
+            DNSServiceRefDeallocate(registered)
+            engine.log("RPPairing: ⚠️ couldn't start registering \(serviceID) (dns_sd error \(started)).")
+            return
+        }
+        localOnlyService = registered
+    }
+}
+
+/// no-wifi: how the local-only registration went. Runs on the main queue.
+private let localOnlyRegistered: DNSServiceRegisterReply = { _, _, error, name, _, _, _ in
+    let service = name.map { String(cString: $0) } ?? "the service"
+    if Int(error) == kDNSServiceErr_NoError {
+        Engine.shared.log("RPPairing: \(service) is registered for this iPhone. Settings › Privacy & Security › Developer Mode should now list “Pair with SideInstaller”.")
+    } else if Int(error) == kDNSServiceErr_PolicyDenied {
+        Engine.shared.log("RPPairing: ⚠️ iOS refused to register \(service): Local Network is off for SideInstaller.")
+    } else {
+        Engine.shared.log("RPPairing: ⚠️ registering \(service) for this iPhone failed (dns_sd error \(error)).")
     }
 }
 
