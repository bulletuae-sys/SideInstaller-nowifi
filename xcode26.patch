xcode26.patch: build with Xcode 26 (iOS 26.x SDK) when no Xcode 27 is available.

Applies to FrizzleM/SideInstaller (ios-app/). Removes the two calls to iOS 27
APIs that the iOS 26 SDK doesn't have: BGTaskScheduler's async
submitTaskRequest (the synchronous submit is used on every iOS) and
AVAudioSession's iOS 27 interruption notifications (interruptionNotification
still handles interruptions). Built with an SDK before 27.1, the app runs in a
window on the iPhone Duo; on other iPhones it is the same.

diff --git a/ios-app/InstallActivity.swift b/ios-app/InstallActivity.swift
index 50fe4cd..457966c 100644
--- a/ios-app/InstallActivity.swift
+++ b/ios-app/InstallActivity.swift
@@ -433,21 +433,12 @@ final class InstallActivity {
         // A task iOS only queues would start after the user stopped waiting.
         request.strategy = .fail
         taskID = identifier
-        if #available(iOS 27.0, *) {
-            // Not from the main thread, the header says.
-            Task.detached { [weak self] in
-                do {
-                    try await BGTaskScheduler.shared.submitTaskRequest(request)
-                } catch {
-                    await self?.taskRefused(identifier, error)
-                }
-            }
-        } else {
-            do {
-                try BGTaskScheduler.shared.submit(request)
-            } catch {
-                taskRefused(identifier, error)
-            }
+        // xcode26: the iOS 26 SDK has no submitTaskRequest(_:), iOS 27's
+        // async submit, so every iOS takes the synchronous one.
+        do {
+            try BGTaskScheduler.shared.submit(request)
+        } catch {
+            taskRefused(identifier, error)
         }
         return true
     }
